# app_image is a named Compose build context pointing at the app service image.
FROM app_image
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl xz-utils libgl1 libegl1 libx11-6 libxi6 libxrender1 \
      libxfixes3 libxcursor1 libxrandr2 libxxf86vm1 libsm6 libice6 libxkbcommon0 \
      libdbus-1-3 libgomp1 libfontconfig1 libzstd1 \
    && curl --fail --location --retry 3 https://download.blender.org/release/Blender4.5/blender-4.5.15-linux-x64.tar.xz -o /tmp/blender.tar.xz \
    && echo '0d2b8bb2efe97e6c8eb57de6b7322f8800e1984e3125b60decca5f6771e4773e  /tmp/blender.tar.xz' | sha256sum -c - \
    && mkdir /opt/blender && tar -xJf /tmp/blender.tar.xz -C /opt/blender --strip-components=1 \
    && rm /tmp/blender.tar.xz && rm -rf /var/lib/apt/lists/*
ENV BLENDER_BINARY=/opt/blender/blender \
    BLENDER_USER_CONFIG=/tmp/blender-config \
    BLENDER_USER_SCRIPTS=/tmp/blender-scripts \
    XDG_CACHE_HOME=/tmp/blender-cache
USER croquis3r
CMD ["python", "manage.py", "render_worker"]
