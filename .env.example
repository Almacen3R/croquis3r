DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# sqlite para empezar; postgres para usar el servicio de compose.yaml.
DB_ENGINE=sqlite
POSTGRES_DB=croquis3r
POSTGRES_USER=croquis3r_app
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
APP_PORT=8013
DJANGO_CSRF_TRUSTED_ORIGINS=

# Precios de 3R: usuario SQL externo de solo SELECT. Sin secretos en Git.
THREER_PRICING_ENABLED=0
THREER_SQL_HOST=
THREER_SQL_PORT=1433
THREER_SQL_DATABASE=ALMACEN_3R
THREER_SQL_SCHEMA=ALMACEN_3R
THREER_SQL_USER=
THREER_SQL_PASSWORD=
THREER_SQL_PRICE_LEVEL=GENERAL
THREER_SQL_CURRENCY=L
THREER_SQL_PRICE_INCLUDES_TAX=1
